@startuml
!include <C4/C4_Component>
!include <C4/C4_Context>

Person(dev, "Operator", "Runs CLI and reviews artifacts")

System_Boundary(tool, "doctrinify") {
    Component(cli, "Console Commands", "src/Command", "tools:sandbox:prepare, tools:orm:generate, tools:orm:clean")
    Component(ormSvc, "OrmGeneratorService", "src/Service", "Deterministic generation pipeline")

    Component(codebase, "Codebase Loader", "src/Tools/Codebase", "Reads config, classlist/autoscan, builds inheritance trees")
    Component(intro, "Introspection", "src/Tools/Introspection", "AST model + DB schema introspection")
    Component(analyze, "Pipeline Analyzer", "src/Tools/Analysis", "Resolves table/key/relation decisions")
    Component(codegen, "Codegen", "src/Tools/Codegen", "Doctrine XML + AST member generation")
    Component(persist, "Persister", "src/Tools/Persist", "Writes XML, applies AST mutations, writes mismatch-report")
}

System_Ext(models, "Sandbox Models", "sandbox/models")
System_Ext(fixtures, "Fixture Models", "tests/_data/mock/models")
System_Ext(schema, "Sandbox Schema", "tests/_data/mock/database/schema.sql")
System_Ext(genFs, "Generated Artifacts", "sandbox/doctrine + sandbox/models")

Rel(dev, cli, "runs")
Rel(cli, models, "tools:sandbox:prepare sync from fixture source")
Rel(models, fixtures, "is synchronized from")

Rel(cli, ormSvc, "tools:orm:*")
Rel(ormSvc, codebase, "load")
Rel(ormSvc, intro, "introspect")
Rel(ormSvc, analyze, "analyze")
Rel(ormSvc, codegen, "generate")
Rel(ormSvc, persist, "persist")

Rel(intro, models, "reads")
Rel(intro, schema, "reads")
Rel(persist, genFs, "writes")

@enduml
