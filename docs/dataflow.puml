@startuml
left to right direction

rectangle "Sandbox Inputs" {
    file "Models\ntests/_data/mock/models/*.php" as models
    file "Schema\ntests/_data/mock/database/schema.sql" as schema
    file "Config\nconfig.yaml" as cfg
}

rectangle "Core Generator (deterministic)" {
    component "tools:orm:generate" as genCmd
    component "OrmGeneratorService" as orm
    database "Generated XML/PHP\ngenerated/*" as genOut
    file "Mismatch Report\ngenerated/doctrine/mismatch-report.txt" as mismatch
}

rectangle "AI Sidecar" {
    file "Workbook\nsrc/Tools/Tasks/test.xlsx" as xlsx
    component "tools:ai:task-execute" as aiCmd
    database "Task Artifacts\nvar/tasks/<task_set>/{inputs,prompts,results}" as taskOut
    component "tools:report:build" as repCmd
    file "HTML Report\nvar/tasks/<task_set>/reports/*.html" as html
}

models --> genCmd
schema --> genCmd
cfg --> genCmd

genCmd --> orm
orm --> genOut
orm --> mismatch

xlsx --> aiCmd
models --> aiCmd
schema --> aiCmd
genOut --> aiCmd
mismatch --> aiCmd
aiCmd --> taskOut

taskOut --> repCmd
repCmd --> html

@enduml
