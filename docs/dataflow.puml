@startuml
left to right direction

rectangle "Sandbox Inputs" {
    file "Runtime Models\nsandbox/models/*.php" as models
    file "Fixture Models\ntests/_data/mock/models/*.php" as fixtures
    file "Schema\ntests/_data/mock/database/schema.sql" as schema
    file "Config\nconfig.yaml" as cfg
    component "tools:sandbox:prepare" as prepCmd
}

rectangle "Core Generator (deterministic)" {
    component "tools:orm:generate" as genCmd
    component "OrmGeneratorService" as orm
    database "Generated XML\nsandbox/doctrine/*.orm.xml" as genOut
    file "Patched Models\nsandbox/models/*.php" as patched
    file "Mismatch Report\nsandbox/doctrine/mismatch-report.txt" as mismatch
}

fixtures --> prepCmd
prepCmd --> models
models --> genCmd
schema --> genCmd
cfg --> genCmd

genCmd --> orm
orm --> genOut
orm --> patched
orm --> mismatch

@enduml
