<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
  <entity name="app\models\Product" table="product">
    <id name="id" type="integer">
      <generator strategy="AUTO"/>
    </id>
    <field name="sku" type="string"/>
    <field name="name" type="string"/>
    <field name="price" type="decimal"/>
    <field name="stock" type="integer"/>
    <one-to-many field="orderItems" target-entity="app\models\OrderItem" mapped-by="product"/>
    <one-to-many field="productCategories" target-entity="app\models\ProductCategory" mapped-by="product"/>
    <one-to-many field="categories" target-entity="app\models\Category" mapped-by="product"/>
  </entity>
</doctrine-mapping>
