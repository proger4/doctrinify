<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
  <entity name="app\models\ProductCategory" table="product_category">
    <id name="product_id" type="integer">
      <generator strategy="NONE"/>
    </id>
    <id name="category_id" type="integer">
      <generator strategy="NONE"/>
    </id>
    <field name="assigned_at" type="datetime" nullable="true"/>
    <many-to-one field="product" target-entity="app\models\Product">
      <join-column name="product_id" referenced-column-name="id"/>
    </many-to-one>
    <many-to-one field="category" target-entity="app\models\Category">
      <join-column name="category_id" referenced-column-name="id"/>
    </many-to-one>
  </entity>
</doctrine-mapping>
