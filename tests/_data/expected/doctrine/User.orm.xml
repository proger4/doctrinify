<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
  <entity name="app\models\User" table="user">
    <id name="id" type="integer">
      <generator strategy="AUTO"/>
    </id>
    <field name="username" type="string"/>
    <field name="password_hash" type="string"/>
    <field name="type" type="string"/>
    <field name="created_at" type="datetime" nullable="true"/>
    <inheritance-type value="SINGLE_TABLE"/>
    <discriminator-column name="type" type="string"/>
    <discriminator-map>
      <discriminator-mapping value="user" class="app\models\User"/>
      <discriminator-mapping value="admin" class="app\models\Admin"/>
      <discriminator-mapping value="moderator" class="app\models\Moderator"/>
    </discriminator-map>
  </entity>
</doctrine-mapping>
