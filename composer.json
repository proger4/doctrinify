{
  "name": "doctrinify/doctrinify",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "nicmart/tree": "^0.10.1",
    "symfony/console": "^7.3",
    "symfony/yaml": "^8.0"
  },
  "require-dev": {
    "codeception/codeception": "^5.3",
    "codeception/module-asserts": "^3.3",
    "codeception/module-filesystem": "^3.0",
    "phpstan/phpstan": "^1.12",
    "squizlabs/php_codesniffer": "^3.11",
    "vimeo/psalm": "^6.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/codecept run"
  }
}
