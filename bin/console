#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Command\CleanCommand;
use App\Command\GenerateCommand;
use App\Command\PrepareSandboxCommand;
use Symfony\Component\Console\Application;

require_once __DIR__ . '/../vendor/autoload.php';

$application = new Application('Doctrinify');
$application->add(new GenerateCommand());
$application->add(new CleanCommand());
$application->add(new PrepareSandboxCommand());
$application->run();
